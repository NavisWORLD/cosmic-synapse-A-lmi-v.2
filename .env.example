# Local development template only. Do not put real credentials in this file.
# Copy this file to .env, replace every placeholder, and keep .env untracked.
# Docker Compose requires the secret-bearing values below rather than falling
# back to committed default passwords.

A_LMI_MINIO_ACCESS_KEY=replace-with-local-minio-user
A_LMI_MINIO_SECRET_KEY=replace-with-long-random-minio-secret
A_LMI_NEO4J_USERNAME=neo4j
A_LMI_NEO4J_PASSWORD=replace-with-long-random-neo4j-secret

# Separate credentials used by the MinIO instance backing Milvus.
MILVUS_MINIO_ACCESS_KEY=replace-with-local-milvus-minio-user
MILVUS_MINIO_SECRET_KEY=replace-with-long-random-milvus-minio-secret
